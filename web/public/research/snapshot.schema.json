{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quantum Observatory research snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "source",
    "evidenceLevel",
    "schemaVersion",
    "mode",
    "createdAt",
    "retrievalDate",
    "changes",
    "modelEvaluation",
    "provenance",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "evidenceLevel": {
      "const": "documentation-snapshot"
    },
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "static"
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    },
    "retrievalDate": {
      "type": "string",
      "format": "date"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modelEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "model",
        "baselineParameters",
        "evidence",
        "limitations"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "baselineParameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uniformMixingPercent",
            "observationFeedbackPercent"
          ],
          "properties": {
            "uniformMixingPercent": {
              "const": 25
            },
            "observationFeedbackPercent": {
              "const": 25
            }
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceCommit",
        "documentPath",
        "documentSha256",
        "method",
        "review"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "documentPath": {
          "type": "string",
          "minLength": 1
        },
        "documentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "authors",
          "url",
          "retrievalDate",
          "retrievalBasis",
          "evidenceLevel",
          "topic",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "retrievalDate": {
            "type": "string",
            "format": "date"
          },
          "retrievalBasis": {
            "type": "string",
            "minLength": 1
          },
          "evidenceLevel": {
            "const": "theoretical-background"
          },
          "topic": {
            "enum": [
              "Probability",
              "Interference",
              "Decoherence"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
